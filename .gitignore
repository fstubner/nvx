# Binaries. Anchored to the repo root: unanchored `nvx` also matched the
# directory npm/nvx/, so the wrapper package was never committed and a fresh
# checkout had no npm/nvx for release.yml to publish from.
/nvx
/nvx.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test / Cache / Temp dirs
downloads/
versions/
current/
npm_global/
.nvx/

# OS-specific
.DS_Store
Thumbs.db

# Build distribution
dist/

# Platform binaries copied into the npm packages at publish time. Previously
# ignored by the unanchored `nvx` rule above; named explicitly now that it is
# anchored, so a publish run does not leave them as untracked files.
npm/*/bin/nvx

# Release Notes (Temporary)
release-notes.md

# Internal development session notes (never publish)
docs/session-history-*.md



# Stray probe files from acceptance runs, which once reached a release tag.
ACC_*.tmp
*.tmp

# Agent and review scratch output. These are working notes, not part of the
# product, and a `git add -A` swept them into a commit once already (a255d15
# undid it). Ignored so that cannot happen again.
.agent-evidence/
IMPLEMENTATION_PLAN.md
docs/assessment-*.md
docs/product-review-*.md

# Diagnostic bundles written by `nvx report` into whatever directory it was
# run from, which during development is this one. One reached a commit on
# 2026-09-06 via `git add -A`, the same way the review scratch above did.
nvx-report-*.txt
