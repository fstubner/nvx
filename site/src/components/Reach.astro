---
import { reachColumns, reachCopy, reachNote, reachRows } from '../data/site-content/reach';

// Imports its content directly rather than through `site`, because this
// section is nvx's own rather than one of the template's four. Everything
// else on the page reads `site`; if this section is ever generalised, it
// should move there with the rest.
---

<section id="reach">
  <div class="w">
    <h2>{reachCopy.heading}</h2>
    <p class="lead" set:html={reachCopy.leadHtml} />

    <!-- Scrollable, and focusable because it scrolls: axe's
         scrollable-region-focusable wants a scrollable region reachable by
         keyboard, and a table of text has no focusable descendant of its own. -->
    <div class="reach-scroll" tabindex="0">
      <table class="reach-table">
        <thead>
          <tr>
            <th scope="col">{reachColumns.target}</th>
            <th scope="col">{reachColumns.others}</th>
            <th scope="col" class="nvx">{reachColumns.nvx}</th>
          </tr>
        </thead>
        <tbody>
          {reachRows.map((r) => (
            <tr>
              <th scope="row">
                <code>{r.target}</code>
                <span class="reach-what">{r.what}</span>
              </th>
              <td><span class="verdict plain">{r.plain}</span></td>
              <td class="nvx"><span class="verdict contained">{r.contained}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <aside class="reach-note">
      <p class="reach-note-head">{reachNote.heading}</p>
      <p set:html={reachNote.bodyHtml} />
      <p set:html={reachNote.measuredHtml} />
    </aside>
  </div>
</section>

<style is:global>
/* ─── WHAT AN INSTALL CAN REACH ─── */

/* One row per target, so a path appears once and the eye travels sideways to
   compare. The previous version was two columns of cards listing the same five
   paths twice, which left the reader pairing them up by hand. */
.reach-scroll{
  overflow-x:auto;
  margin-bottom:24px;
  border:1px solid rgba(var(--ui-hairline-rgb),.22);
  border-radius:12px;
  background:var(--ui-surface-raised);
}
.reach-table{width:100%;border-collapse:collapse;font-size:.8125rem}

.reach-table th,
.reach-table td{
  text-align:left;
  padding:11px 18px;
  border-top:1px solid rgba(var(--ui-hairline-rgb),.12);
  vertical-align:middle;
}
.reach-table thead th{
  border-top:0;
  padding-top:14px;padding-bottom:14px;
  font-size:.6875rem;font-weight:700;
  letter-spacing:.06em;text-transform:uppercase;
  color:var(--ui-text-muted);
  white-space:nowrap;
}
.reach-table tbody th{font-weight:400}

/* The compared column is a tint with an accent edge along the top, not a box
   ruled on all four sides. A 2px rectangle floating over the rows read as a
   selection marquee rather than as emphasis. The tint is 6%, which composites
   to rgb(41,40,55) in the dark theme -- --ui-accent on that measures 4.30:1
   and fails, which is why the verdicts in this column use --ui-accent-bright
   at 8.83:1 dark and 8.23:1 light. */
.reach-table th.nvx,
.reach-table td.nvx{background:rgba(var(--ui-accent-rgb),.06)}
.reach-table thead th.nvx{
  color:var(--ui-accent);
  border-top:2px solid var(--ui-accent);
}

/* Plain mono, no chip. The global `code` rule gives every inline code a
   background and padding; as a table cell's only child at display:block that
   painted a full-width slab behind every path, which is what made the table
   read as a wireframe. */
.reach-table code{
  display:inline-block;
  background:none;padding:0;border-radius:0;
  font-family:ui-monospace,"SF Mono",Menlo,monospace;
  font-size:.8125rem;
  color:var(--ui-text-strong);
}
.reach-what{
  display:block;margin-top:3px;
  font-size:.75rem;color:var(--ui-text-muted);
}

/* Words, not pills. An outlined capsule in every cell is placeholder styling;
   a comparison table wants the answer to read as text. */
.verdict{font-weight:700;font-size:.75rem;letter-spacing:.01em;white-space:nowrap}
.verdict.plain{color:var(--ui-warn)}
.verdict.contained{color:var(--ui-accent-bright)}

/* The caveat is a peer of the table, not a footnote under it. Someone reading
   this on a Mac is looking at a narrower product than someone on Windows. */
.reach-note{
  border:1px solid rgba(var(--ui-hairline-rgb),.22);
  border-left:3px solid var(--ui-warn);
  border-radius:10px;
  padding:18px 20px;
  background:var(--ui-surface);
}
.reach-note-head{
  font-size:.8125rem;font-weight:700;
  color:var(--ui-text-strong);
  margin:0 0 8px;
}
/* No opacity dimming on these. At .88 the measured-evidence paragraph
   composited to 4.11:1 in the light theme against a 4.5 floor, and an in-page
   contrast sweep does not catch it: opacity applies to the element, not to the
   colour a checker reads. */
.reach-note p{
  font-size:.8125rem;line-height:1.65;
  color:var(--ui-text-muted);
  margin:0 0 8px;
}
.reach-note p:last-child{margin-bottom:0}
.reach-note code{
  font-family:ui-monospace,"SF Mono",Menlo,monospace;
  font-size:.75rem;
  color:var(--ui-text);
}

@media(max-width:720px){
  .reach-table th,
  .reach-table td{padding:10px 12px}
  .reach-table thead th{font-size:.6875rem}
}
</style>
