---
import { site } from '../data/site';
import Visual from './Visual.astro';
const { surfaces, copy, modules } = site;
const surfacesLeadHtml = modules.docs
  ? `${copy.surfaces.leadHtml} <a href="/docs/">Full docs →</a>`
  : copy.surfaces.leadHtml;
// Cards with no picture of any kind lay out as a grid of text cards instead
// of image-and-text rows, which left half of every row empty.
const hasVisual = (s: (typeof surfaces)[number]) => Boolean(s.visual || s.image || s.codeHtml);
const textOnly = surfaces.every((s) => !hasVisual(s));
---
<section id="surfaces" class="surfaces-section">
  <div class="w">
    <div class="surfaces-intro">
      <h2>{copy.surfaces.heading}</h2>
      <p class="lead" set:html={surfacesLeadHtml} />
    </div>

    <div class={`surfaces${textOnly ? ' text-only' : ''}`}>
      {surfaces.map((s) => (
        <div class={`surface${textOnly ? '' : s.wide ? ' wide' : s.flip ? ' flip' : ''}`}>
          <div class="surface-text">
            <h3>{s.title}</h3>
            <p set:html={s.body} />
            {s.downloads && (
              <div class="surface-downloads">
                {s.downloads.map((d) => (
                  <a class="surface-download-btn" href={d.url} download>
                    <span class="dl-label">{d.label}</span>
                    {d.hint && <span class="dl-hint">{d.hint}</span>}
                  </a>
                ))}
              </div>
            )}
          </div>
          {hasVisual(s) && <div class="surface-visual">
            {s.visual ? (
              <Visual visual={s.visual} />
            ) : s.image ? (
              <picture>
                {s.image.webp && <source type="image/webp" srcset={s.image.webp} />}
                <img
                  src={s.image.src}
                  alt={s.image.alt}
                  width={s.image.width}
                  height={s.image.height}
                  loading="lazy"
                />
              </picture>
            ) : s.codeHtml ? (
              <div
                class="codeblock has-copy"
                tabindex="0"
                role="region"
                aria-label="Code example"
                set:html={s.codeHtml}
              />
            ) : null}
          </div>}
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
/* ─── SURFACE CARDS ─── */
.surfaces-section{
  background:var(--ui-surface);
  border-block:1px solid rgba(var(--ui-lift-rgb),.045);
}
.surfaces-section::before{
  content:none;
}
.surfaces-intro{
  max-width:720px;
  margin-bottom:56px;
}
.surfaces-intro .lead{
  max-width:690px;
  margin-bottom:0;
}
/* 72, down from 90: with the rows centred, 90px between them read as four
   separate islands rather than one tour. */
.surfaces{display:grid;gap:72px}
.surface{
  display:grid;grid-template-columns:1fr 1fr;gap:64px;
  /* Centred, not top-aligned. Every text block in this section is 118px tall
     and every visual beside it is 218-296px, so `start` left 100-178px of
     empty column under each paragraph -- about 560px of void in a 1608px
     section, which is what made the tour read as ragged rather than as four
     matched rows. */
  align-items:center;
}
/* No band on the surface cards.
 *
 * They had one -- every other card on a full-bleed #1c2634 -- and it made
 * the page invert seven times between the hero and the footer, each join a
 * 14.75:1 step. That reads as stripes rather than as sections.
 *
 * Gradient joins were tried as a softener and were worse: fading #1c2634
 * into #fbfbfb runs through a muddy mid-grey, so 64px of it at every edge
 * looked like a blur artifact. Spreading a 14.75:1 step does not shrink it,
 * which is the tell that the edge was never the problem.
 *
 * The two dark moments that remain are the install section and the footer --
 * see landing/base.css. Three edges instead of seven, and the four cards read as
 * one continuous tour rather than as alternating stripes. */

/* Grid children default to min-width:auto (content-based), which lets a
   long <pre> codeblock force the grid wider than the viewport. Clamping
   to 0 lets the codeblock's own overflow-x:auto contain the overflow. */
.surface>*{min-width:0}
.surface.flip{direction:rtl}
.surface.flip>*{direction:ltr;min-width:0}
.surface-text{padding-top:0}
.surface-text h3{font-size:1.125rem;font-weight:700;color:var(--ui-text-strong);margin:0 0 22px}
/* The body ink, not the muted step. The paragraph is the card's content, not
   a caption under it, and in the muted grey it read as secondary to the code
   beside it. */
.surface-text p{font-size:.875rem;color:var(--ui-text);margin:0;line-height:1.6}
.surface-text code{font-size:.75rem}
.surface-visual picture{
  display:block;
  line-height:0;
}
.surface-visual img{
  display:block;
  width:100%;height:auto;border-radius:10px;
  border:1px solid rgba(var(--ui-lift-rgb),.08);
  box-shadow:var(--ui-lift-md);
  /* zoom-in: the lightbox opens it. Was in Hero.astro, which does not own
     this class; every component's styles are global, so each keeps to its
     own markup. */
  cursor:zoom-in;
}
.surface-visual img:focus-visible,
.bigshot img:focus-visible{
  outline:2px solid var(--ui-accent);
  outline-offset:3px;
}
.surface-visual .codeblock{
  /* Dark in both themes -- see the code-surface note in tokens.css. */
  background:var(--ui-code-bg);border:1px solid var(--ui-code-border);
  border-radius:10px;padding:16px 58px 16px 20px;
  font-family:ui-monospace,"SF Mono",Menlo,monospace;
  font-size:.75rem;line-height:1.7;white-space:pre;overflow-x:auto;color:var(--ui-text);
  box-shadow:var(--ui-lift-md);
  position:relative;
}
/* Same glyph classes and same reasoning as .hero-term's in Hero.astro:
   real npm/nvx status colors (LogInfo/LogWarn/LogError in main.go), not an
   invented palette. Duplicated rather than shared because each component
   keeps to its own markup -- see the zoom-in comment above. */
.codeblock .t-dim{color:var(--ui-ondark-text-muted)}
.codeblock .t-info{color:var(--ui-ondark-info)}
.codeblock .t-ok{color:var(--ui-ondark-ok)}
.codeblock .t-warn{color:var(--ui-ondark-warn)}
.codeblock .t-err{color:var(--ui-ondark-err)}
.codeblock .t-hi{color:var(--ui-ondark-text-strong)}
/* Text above, visual across the row: for a visual whose panes need the
   width more than they need to sit beside the text. */
.surface.wide{grid-template-columns:1fr;gap:28px}
.surface.wide .surface-text{max-width:720px}
/* Text cards: two across, one on a phone. The hairline and tint match the
   FAQ's closed rows, so the cards read as part of the same page. */
.surfaces.text-only{grid-template-columns:1fr 1fr;gap:20px}
.surfaces.text-only .surface{
  display:block;padding:24px;border-radius:10px;
  border:1px solid rgba(var(--ui-lift-rgb),.08);
  background:rgba(var(--ui-lift-rgb),.02);
}
.surfaces.text-only .surface-text h3{margin-bottom:10px}
@media(max-width:720px){
  .surfaces.text-only{grid-template-columns:1fr}
  .surface{grid-template-columns:1fr;gap:28px}
  .surface.flip{direction:ltr}
}
/* On a phone a code visual wraps, as a terminal that width would, rather
   than running off the card's right edge behind a scrollbar nobody sees. */
@media(max-width:560px){
  .surface-visual .codeblock{white-space:pre-wrap;overflow-wrap:anywhere}
}

</style>
