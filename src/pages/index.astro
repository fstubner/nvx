---
import Page from '../layouts/Page.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Surfaces from '../components/Surfaces.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const githubRepo = site.social.repo;
const heroDownloads = site.hero.downloads ?? [];
---
<Page>
  <Nav />
  <main id="main">
    <Hero />
    <Surfaces />
    <Install />
    <Faq />
  </main>
  <Footer />

  <script define:vars={{ githubRepo, heroDownloads }}>
    import { initLandingPage } from '../scripts/landing-page';
    initLandingPage(githubRepo, heroDownloads);
  </script>
</Page>
